{
  "name": "protobuf-config-loader",
  "description": "Protobuf-style schemas for typed application config: parse schema definitions, merge JSON + env sources, apply defaults, and validate with precise error paths",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pcl": "bin/pcl.js"
  },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "bun test"
  },
  "keywords": [
    "config",
    "configuration",
    "protobuf",
    "schema",
    "validation",
    "loader",
    "env",
    "defaults"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/protobuf-config-loader.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.5.0"
  }
}
